# Environment Configuration Example
# Copy this to .env and fill in your actual credentials

# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/openai/gpt-oss-120b

# Optional: Additional LLM settings
# LLM_TEMPERATURE=0.7              # Model temperature (0-1)
# LLM_MAX_TOKENS=4000              # Max tokens per request
# LLM_TIMEOUT=30                   # Request timeout in seconds

# Database settings
# DATABASE_PATH=bank_data.db       # Leave default unless you have specific needs
# DATABASE_TYPE=sqlite             # Currently only sqlite supported

# Rate limiting (optional, defaults are safe)
# MAX_RPM=900                      # Requests per minute (default: 900, max: 1000)
# MIN_REQUEST_INTERVAL=0.1         # Seconds between requests (default: 0.1)

# Logging (optional)
# LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR, CRITICAL
# VERBOSE_AGENT_OUTPUT=true        # Enable verbose CrewAI output
